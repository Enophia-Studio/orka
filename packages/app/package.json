{
  "name": "@orka/app",
  "version": "0.5.0",
  "private": true,
  "description": "Orka's chat UI and the controller behind it, shared by the VS Code extension and the desktop app.",
  "license": "MIT",
  "author": "Enophia Software",
  "homepage": "https://github.com/Enophia-Studio/orka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enophia-Studio/orka.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/Enophia-Studio/orka/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "preview": "node esbuild.mjs && node scripts/serve-preview.mjs",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@orka/core": "*"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "typescript": "^5.6.0"
  }
}
